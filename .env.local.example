# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ESPN fantasy API (private league — both cookies required)
ESPN_LEAGUE_ID=130046
ESPN_SWID={your-swid-cookie}
ESPN_S2=your-espn-s2-cookie

# Required by /api/sync. The route fails closed without it.
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on cron invocations.
CRON_SECRET=any-long-random-string
